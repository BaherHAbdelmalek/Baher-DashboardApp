# Copy to .env and fill in. Never commit the filled-in file.

# --- Client (bundled into the browser build; safe to expose) -----------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Server only (Vercel environment variables; NEVER prefix these VITE_) ----
# Prefixing any of these with VITE_ would ship them to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the scheduler sends as the x-cron-secret header.
CRON_SECRET=make-up-a-long-random-string
